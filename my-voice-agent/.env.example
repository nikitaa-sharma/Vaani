# ==============================================================================
# Vaani Voice Agent Environment Template
# Copy to .env.local and fill in your actual credentials.
# ==============================================================================

# LiveKit Cloud Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Sarvam AI (Indian Languages STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key

# OpenWeatherMap API (Optional, for weather queries)
WEATHER_API_KEY=your_weather_api_key

# Google OAuth 2.0 Credentials (for Calendar, Tasks, and Gmail)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/callback
GOOGLE_TOKEN_PATH=google_calendar_token.json
