# ==============================================================================
# Vaani Environment Configuration Template (.env.local)
# Copy this file to .env.local and populate the values below.
# ==============================================================================

# LiveKit Cloud Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Sarvam AI (Speech-to-Text & Text-to-Speech)
SARVAM_API_KEY=your_sarvam_api_key

# Weather API (Optional)
WEATHER_API_KEY=your_weather_api_key

# Google Calendar OAuth 2.0 Credentials (BACKEND ONLY)
# Obtain these from Google Cloud Console:
# 1. Create a project in Google Cloud Console (https://console.cloud.google.com/)
# 2. Enable Google Calendar API
# 3. Configure OAuth consent screen
# 4. Create OAuth 2.0 Client ID (Web Application or Desktop App)
# 5. Add authorized redirect URI: http://localhost:8080/oauth/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/callback

# Optional: Custom path to store backend OAuth credentials (defaults to google_calendar_token.json)
# GOOGLE_TOKEN_PATH=google_calendar_token.json
